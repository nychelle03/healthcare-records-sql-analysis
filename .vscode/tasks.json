{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run current SQL file (SQLite)",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/run_sql.py",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
